# Porta do servidor
PORT=8787

# Login com Google (OAuth 2.0). Crie as credenciais no Google Cloud Console
# (APIs & Services > Credentials > OAuth client ID, tipo "Web application")
# e registre o redirect URI abaixo (mais http://localhost:8787/... em dev).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Produção: https://<seu-domínio>/api/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:8787/api/auth/google/callback

# Segredo para assinar o cookie de sessão (obrigatório em produção; troque o valor)
Z_NOTES_SESSION_SECRET=troque-este-segredo

# E-mails com acesso admin (/admin + /api/admin/*), separados por vírgula
Z_NOTES_ADMIN_EMAILS=voce@example.com

# Segredo para assinar tokens JWT (Bearer auth para mobile/desktop). Troque em produção.
# Z_NOTES_JWT_SECRET=troque-este-outro-segredo


# Diretório de dados (SQLite + espelho .md). Default: ./data
# Z_NOTES_DATA_DIR=/caminho/absoluto/para/data

# --- Backup automático ---
# Diretório dos snapshots (separado do data/ ativo). Default: ./backups
# Z_NOTES_BACKUP_DIR=/caminho/absoluto/para/backups

# Expressão cron do agendamento diário. Default: 3h da manhã.
# Z_NOTES_BACKUP_CRON=0 3 * * *

# URL opcional para notificação (POST) caso o backup falhe (ex: ntfy.sh, webhook do Discord/Slack).
# Z_NOTES_BACKUP_WEBHOOK_URL=
